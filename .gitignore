__pycache__/
*.py[cod]
*.nbc
*.nbi
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
benchmarks/cec_suite_cpp/build/
dist/
*.egg-info/
!results/
# Raw DT-GSK per-generation diagnostics traces: deterministic-regenerable bulk
# (seeds recorded in run_config/seed_schedule; single files can exceed GitHub's
# 100 MB limit). The derived diagnostics_analysis CSVs stay tracked.
DTTrace_*.jsonl
# LaTeX build intermediates (papers/); the curated *_missing.log provenance
# files are kept tracked.
papers/*.aux
papers/*.bbl
papers/*.blg
papers/*.out
papers/*.toc
papers/*.log
!papers/*_missing.log

# Reference-paper PDFs are copyrighted acquisition targets, not committed evidence
# (the reference_papers/README.md index + references.bib are tracked; PDFs are not).
reference_papers/*.pdf

# build lock-workaround temp (build_pdf.py writes this when DT-GSK.pdf is open)
papers/DT-GSK.new.pdf

# standalone TikZ compile intermediates (source .tex + final .pdf are kept)
papers/figures/concept/*_src.pdf
papers/figures/concept/*_src.aux
papers/figures/concept/*_src.log

# latexmk build-state byproducts (embed machine-local absolute paths; builds
# go through papers/scripts/build_pdf.py — panel round-2 finding S4-9)
*.fls
*.fdb_latexmk
# stale editor/backup droppings (round-2 finding S4-4)
.bak
*.bak

# agent/tool session state (never publish)
.claude/

# Visio OLE build product (C-001 5.4: never commit; regenerate with
# papers/scripts/embed_visio_ole.py). Committed once by accident 2026-08-01.
papers/DT-GSK_visio.docx
